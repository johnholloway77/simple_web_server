---
Language: Cpp
# FreeBSD KNF (Kernel Normal Form) style
BasedOnStyle: LLVM

# Indentation: 8-character tabs, continuation 4 spaces
UseTab: Always
IndentWidth: 8
TabWidth: 8
ContinuationIndentWidth: 4
ColumnLimit: 80
BreakStringLiterals: false

# Function/struct braces on separate line, control statements inline
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
  AfterStruct: true
  AfterEnum: true
  AfterUnion: true
  AfterControlStatement: false
  BeforeElse: true
  BeforeWhile: false
  IndentBraces: false

# Spaces after keywords (if, while, for) but not function names
SpaceBeforeParens: ControlStatements
SpaceInEmptyParentheses: false
SpacesInParentheses: false
SpacesInSquareBrackets: false

# FreeBSD style: no short statements on single lines
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortBlocksOnASingleLine: Never

# Pointer alignment: attach asterisk to variable name (char *p)
PointerAlignment: Right
DerivePointerAlignment: false

# Switch and goto label indentation per FreeBSD style
IndentCaseLabels: false
IndentGotoLabels: true

# Function parameter alignment
AlignAfterOpenBracket: false
BinPackParameters: false
BinPackArguments: false
AllowAllParametersOfDeclarationOnNextLine: false
AllowAllArgumentsOnNextLine: false

# Binary operators at end of line when wrapping
BreakBeforeBinaryOperators: None
BreakBeforeTernaryOperators: true

# Comment alignment
AlignTrailingComments: false
SpacesBeforeTrailingComments: 1

# Empty lines
MaxEmptyLinesToKeep: 1
KeepEmptyLinesAtTheStartOfBlocks: false

# Return type on separate line for function definitions
AlwaysBreakAfterReturnType: TopLevelDefinitions

# Additional FreeBSD-specific settings
SpaceAfterCStyleCast: false
SpaceBeforeAssignmentOperators: true
SpaceBeforeRangeBasedForLoopColon: true
SpacesInAngles: false
SpacesInCStyleCastParentheses: false
SpacesInContainerLiterals: false

# Penalty settings to prefer FreeBSD-style line breaks
PenaltyBreakAssignment: 50
PenaltyBreakBeforeFirstCallParameter: 100
PenaltyBreakComment: 300
PenaltyBreakFirstLessLess: 120
PenaltyBreakString: 1000
PenaltyReturnTypeOnItsOwnLine: 60

# Preserve manual include grouping (FreeBSD style)
SortIncludes: false
IncludeBlocks: Preserve
